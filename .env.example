# ============================================================
# Environment Configuration Template (.env.example)
# Developer Portfolio - Dhruvil Thummar
# Copy this file to .env and fill in your values
# ============================================================

# Domain / Site URL
SITE_URL=https://drthummar.me
PORT=3000

# Google Analytics Configuration
VITE_GA_TRACKING_ID=your_ga_tracking_id
NEXT_PUBLIC_GA_ID=your_ga_tracking_id


# Contact & Profile Settings
CONTACT_EMAIL=your_email@example.com
GITHUB_PROFILE=https://github.com/yourusername
LINKEDIN_PROFILE=https://www.linkedin.com/in/yourprofile

# SMTP Server Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Your Name" <your_email@gmail.com>
SMTP_TO=your_email@gmail.com

# Optional Email API Keys (for Vercel Serverless / Edge Functions)
RESEND_API_KEY=re_123456789
SENDGRID_API_KEY=SG.123456789

# Vercel Deployment Settings
VERCEL_ENV=development
